{
    "schemaVersion": 1,
    "id": "tyromancy",
    "version": "${version}",

    "name": "Tyromancy",
    "description": "A mod that adds a variety of decorative and colorful blocks to the game.",

    "authors": [
        "MysticKoko",
        "Ragtime_Gal_",
        "Andante",
        "Eggo"
    ],

    "contact": {
        "sources": "https://github.com/hybridlabs/tyromancy",
        "issues": "https://github.com/hybridlabs/tyromancy/issues"
    },

    "license": "ARR (Assets), MIT (Code)",
    "icon": "assets/tyromancy/icon.png",

    "environment": "*",
    "entrypoints": {
        "main": [
            {
                "value": "dev.hybridlabs.tyromancy.Tyromancy",
                "adapter": "kotlin"
            }
        ],
        "client": [
            {
                "value": "dev.hybridlabs.tyromancy.TyromancyClient",
                "adapter": "kotlin"
            }
        ],
        "fabric-datagen": [
            {
                "value": "dev.hybridlabs.tyromancy.data.TyromancyDataGenerator",
                "adapter": "kotlin"
            }
        ],
        "preLaunch": [
            "com.llamalad7.mixinextras.MixinExtrasBootstrap::init"
        ]
    },

    "mixins": [
        "tyromancy.mixins.json",
        "tyromancy.fabric.mixins.json"
    ],

    "accessWidener": "tyromancy-blocks.accesswidener",

    "depends": {
        "minecraft": "1.20.x",
        "java": ">=17",
        "fabric-api": ">=0.92",
        "fabric-language-kotlin": "*"
    }
}
