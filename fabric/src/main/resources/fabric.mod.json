{
    "schemaVersion": 1,
    "id": "hybrid_blocks",
    "version": "${version}",

    "name": "Hybrid Blocks",
    "description": "${description}",

    "authors": [
        "MysticKoko",
        "Aqua",
        "Ragno",
        "Andante",
        "Eggo",
      "murphy slaw"
    ],

    "contact": {
        "homepage": "https://hybridlabs.net/",
        "sources": "https://github.com/hybridlabs/hybrid-blocks",
        "issues": "https://github.com/hybridlabs/hybrid-blocks/issues"
    },

    "license": "ARR (Assets), MIT (Code)",
    "icon": "assets/hybrid_blocks/icon.png",

    "environment": "*",
    "entrypoints": {
        "main": [
            {
                "value": "dev.hybridlabs.blocks.HybridBlocks",
                "adapter": "kotlin"
            }
        ],
        "client": [
            {
                "value": "dev.hybridlabs.blocks.HybridBlocksClient",
                "adapter": "kotlin"
            }
        ],
        "fabric-datagen": [
            {
                "value": "dev.hybridlabs.blocks.data.HybridBlocksDataGenerator",
                "adapter": "kotlin"
            }
        ],
        "preLaunch": [
            "com.llamalad7.mixinextras.MixinExtrasBootstrap::init"
        ]
    },

    "mixins": [
        "hybrid_blocks.fabric.mixins.json"
    ],

    "accessWidener": "hybrid_blocks.accesswidener",

  "depends": {
    "minecraft": "1.20.x",
    "java": ">=17",
    "fabric-api": ">=0.92",
    "fabric-language-kotlin": "*"
  }
}
